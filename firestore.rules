rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者：在 admins 集合裡有自己 uid 的人（只能從 Firebase 主控台新增）
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 每個人只能讀寫自己的個人檔案（要先完成 Email 認證），而且只能存這幾個欄位（不存 Email）
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['nick', 'lineId', 'lineShareConsent', 'nationality', 'area', 'interests', 'activities', 'activityOther', 'langs', 'langLevels', 'wants', 'genderWant', 'age', 'ageWant', 'prefs', 'lifestyle', 'freeTime', 'availabilitySlots', 'years', 'updatedAt'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 20
        && request.resource.data.lineId is string
        && request.resource.data.lineId.size() > 0
        && request.resource.data.lineId.size() <= 100
        && request.resource.data.lineShareConsent == true
        && request.resource.data.nationality is string
        && request.resource.data.nationality.size() <= 30
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 40
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 8
        && request.resource.data.activities is list
        && request.resource.data.activities.size() <= 20
        && request.resource.data.activityOther is string
        && request.resource.data.activityOther.size() <= 40
        && request.resource.data.langs is list
        && request.resource.data.langLevels is map
        && request.resource.data.langLevels.size() <= 6
        && request.resource.data.age is string
        && request.resource.data.ageWant is list
        && request.resource.data.ageWant.size() <= 7
        && request.resource.data.prefs is list
        && request.resource.data.prefs.size() <= 20
        && request.resource.data.lifestyle is string
        && request.resource.data.freeTime is list
        && request.resource.data.freeTime.size() <= 6
        && request.resource.data.availabilitySlots is list
        && request.resource.data.availabilitySlots.size() <= 168
        && request.resource.data.wants is list;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 頭像：只有本人能上傳／刪除；登入的人可以讀
    // （uid 是隨機字串，只會透過小組名單給同組的人知道）
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string
        && request.resource.data.img.size() <= 150000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 小組由管理者在後台（admin.html）建立；成員只能看到自己所在的小組
    match /groups/{groupId} {
      allow read: if (request.auth != null && request.auth.uid in resource.data.memberUids) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
